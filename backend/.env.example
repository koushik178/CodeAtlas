# PostgreSQL + pgvector connection string. Use a managed database URL in production.
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/codeatlas
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true

# Browser origins allowed to call this API. Use a comma-separated, explicit list in production.
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Semantic search and repository Q&A configuration
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
RAG_MAX_CONTEXT_CHARS=24000

# Bounded automated code review configuration
CODE_REVIEW_MAX_CHUNKS=12
CODE_REVIEW_MAX_FILES=8
CODE_REVIEW_MAX_CONTEXT_CHARS=30000
CODE_REVIEW_MAX_FINDINGS=10

# Bounded unit-test generation configuration
TEST_GENERATION_MAX_CHUNKS=8
TEST_GENERATION_MAX_CONTEXT_CHARS=24000

# Compose-only database bootstrap values. Copy to .env and set a strong password.
POSTGRES_DB=codeatlas
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=

# This URL is embedded into the frontend at image build time and must be reachable by browsers.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend integration credentials. Keep these blank in the example and set them only in your secret store/.env.
GITHUB_TOKEN=
OPENAI_API_KEY=

# Use the actual HTTPS frontend origin in production. Do not use * with credentials enabled.
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
